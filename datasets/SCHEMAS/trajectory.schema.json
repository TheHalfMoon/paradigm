{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "template_group": {
      "type": "string",
      "minLength": 1
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "tool_schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "quarantine"
      ]
    },
    "benchmark_test": {
      "type": "boolean"
    },
    "rights_approved": {
      "type": "boolean"
    },
    "verified_success": {
      "type": "boolean"
    },
    "forbidden_side_effects": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "screenshot_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "action_ack_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "observation_sha256",
          "screenshot_id",
          "timestamp_ms",
          "width",
          "height",
          "action",
          "action_ack_id",
          "result",
          "tokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "task_id",
    "template_group",
    "environment_digest",
    "model_revision",
    "tool_schema_digest",
    "split",
    "benchmark_test",
    "rights_approved",
    "verified_success",
    "forbidden_side_effects",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
